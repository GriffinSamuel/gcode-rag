# Copy this file to .env and fill in ONE provider. Leave everything blank to run in retrieval-only mode
# (the project still builds, tests, and evaluates retrieval; generated answers and G-code need a key).
# Never commit .env. The agent is forbidden from reading or editing it; it only runs scripts/check_env.py.

# anthropic | openai_compatible | (blank)
LLM_PROVIDER=anthropic

# The API key for the provider above.
LLM_API_KEY=

# anthropic: claude-haiku-5-5 is the cheapest and plenty for this project.
# openai_compatible examples: Groq llama-3.3-70b-versatile ; Gemini gemini-2.5-flash ; Ollama llama3.1 (check your provider's current model names)
LLM_MODEL=claude-haiku-5-5

# openai_compatible only. Groq: https://api.groq.com/openai/v1   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Optional overrides
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: Hugging Face write token to auto-deploy the Gradio app to a free Space. Leave blank to skip deployment.
HF_TOKEN=
